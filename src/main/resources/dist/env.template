# Dev Agent 설정 파일(.env) — 이 PC 에만 두는 값입니다. 고친 뒤에는 재시작하세요(트레이 아이콘 > 재시작, 또는 플랫폼 탭 > 설치 점검).
# 비워 둔 항목은 기본값으로 동작합니다. 무엇이 빠졌는지는 화면의 "플랫폼 > 설치 점검"에서 확인할 수 있습니다.

# --- GitHub (이슈 에이전트 · 질의에 필요) ---
ISSUE_ENABLED=false
# fine-grained PAT: Repository access "All repositories"(개인 계정 저장소 전부, 조직 저장소 제외), 권한 Contents·Issues·Pull requests 읽기/쓰기 + Metadata 읽기,
# 만료 90일 안팎. 토큰이 새면 개인 저장소 전부가 노출된다. 서버 .env(권한 600)에만 두고, 앱은 대상 프로젝트로 고른 저장소만 처리한다. 발급: GitHub > Settings > Developer settings > Personal access tokens
GITHUB_TOKEN=
#GITHUB_TRUSTED_AUTHORS_ONLY=true   # 기본 켜짐: 이슈 작성자가 저장소 OWNER/MEMBER/COLLABORATOR 일 때만 처리
# 대상 저장소 초기값(쉼표 구분 owner/repo). 이후에는 화면에서 추가·삭제합니다.
ISSUE_PROJECTS=
# ISSUE_GIT_USER_NAME=
# ISSUE_GIT_USER_EMAIL=

# --- 메신저 — 기본은 없음(none). MessengerPort 어댑터를 추가했다면 그 이름을 적습니다 ---
# PLATFORM_MESSENGER=none

# --- 데이터베이스 — 비우면 내장 PostgreSQL 을 씁니다(추가 설치 없음) ---
# DB_URL=jdbc:postgresql://localhost:5432/dev_agent
# DB_USERNAME=
# DB_PASSWORD=

# --- Claude Code CLI — 비우면 자동으로 찾습니다 ---
# CLAUDE_EXE_COMMAND=

# --- 그 밖 ---
# 화면 포트(기본 8777)
# ADMIN_PORT=8777
# 루프백 외에 상태 변경 요청을 허용할 Origin(쉼표 구분, 정확히 일치). 예: https://<MagicDNS 이름>:8443
# ACCESS_ALLOWED_ORIGINS=
