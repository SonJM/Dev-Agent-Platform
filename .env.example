# Dev Agent 환경변수 템플릿
# 실제 값을 채워 ".env" 로 복사해서 사용하세요 (.env 는 git 에 올라가지 않습니다).
#   cp .env.example .env

# ── 메신저 ──────────────────────────────────────────────
# 기본은 없음(none): 화면만 씁니다. MessengerPort 어댑터를 추가했다면 그 이름을 적습니다.
PLATFORM_MESSENGER=none

# ── 멘션/자동응답 ────────────────────────────────────────
# 남이 나를 부르는 키워드(쉼표구분). 접미사 자동포함: "@길동"→@길동BE
BOT_MENTION_KEYWORDS=@봇이름,@봇
# 내가 봇을 직접 호출하는 명령 키워드 (내 메시지여도 응답)
BOT_COMMAND_KEYWORD=@AI
# AUTO(그 방에 실제 회신) 허용 방 — 쉼표구분. 비우면 전부 DRAFT(내 자기방 초안).
# room-key 는 list-rooms.cmd 로 확인. 예) BOT_AUTO_ROOMS=single:586,group:17617
BOT_AUTO_ROOMS=
# @AI 방 응답 중 느린 턴(문서 참고)에 "생성 중" 안내 선전송(기본 off — 메시지 노이즈 방지)
BOT_PROGRESS_ACK=false

# ── LLM (Claude Code CLI headless) ───────────────────────
# Enterprise 구독의 Claude Code CLI 를 headless 로 호출 — 별도 API 키 불필요.
# ⚠️ 구독의 서버 자동화 사용은 약관 확인 권장.
CLAUDE_CLI_COMMAND=
CLAUDE_TIMEOUT_MS=120000
# 성능: warm(상주) 프로세스 재사용 (2번째 요청부터 ~1s). false 면 호출마다 새 프로세스.
CLAUDE_WARM=true
CLAUDE_WARM_RESET_TURNS=20
# warm 은 claude.exe 를 직접 실행(한글 인자 안전). npm 전역 설치 경로 기준.
CLAUDE_EXE_COMMAND=
CLAUDE_MODEL=sonnet
CLAUDE_EFFORT=low
# 안정성/속도: 기동·리셋 시 백그라운드 프리웜(콜드스타트 체감 제거) + warm 연속실패 서킷브레이커
CLAUDE_WARM_PREWARM=true
CLAUDE_WARM_FAIL_THRESHOLD=3         # 연속 N회 실패 시 일시적으로 one-shot 전용
CLAUDE_WARM_BREAKER_COOLDOWN_MS=60000

# ── 사내 문서 참고(RAG) ──────────────────────────────────
# @AI 질문 시 관련 사내문서(MkDocs)를 찾아 근거로 답하고 출처 URL을 붙임.
# 적재는 기동/스케줄(핫패스 밖), 검색은 DB 1쿼리. 관련 문서 없으면 주입 생략(평소 속도 유지).
DOCS_ENABLED=false
DOCS_SEARCH_INDEX_URL=
DOCS_SITE_BASE_URL=
DOCS_REFRESH_CRON=0 30 6 * * *     # 매일 06:30 재적재
DOCS_REFRESH_ON_STARTUP=true
DOCS_TOP_K=4                       # 주입할 최대 섹션 수
DOCS_MIN_SCORE=2                   # 게이트 임계치(최고 점수가 이 미만이면 문서 주입 안 함)
DOCS_MAX_CONTEXT_CHARS=6000        # 주입 컨텍스트 총 길이 상한
DOCS_USE_IN_MENTIONS=true          # 남의 멘션 초안/AUTO 회신에도 관련 문서 참고(게이트 통과 시만)

# ── GitLab 이슈 수정 에이전트 ─────────────────────────────
# 라벨(ai-fix) 붙은 열린 이슈를 1건씩 처리: 분석/설계 → (자기방 확인) → 수정 → (자기방 확인) → ai/ 브랜치 푸시 → 코멘트·Draft MR
# 자기방에서 "@AI 이슈 상태 | 목록 | 스캔 | 중단 | group/repo#123" 명령. 확인 대기 중엔 자기방에 그냥 답하면 됨(진행/중단/diff/피드백).
# 운영 MCP (opensearch/postgres 는 인증 없음, k3s-ops 는 Bearer 토큰 — 담당자에게 받아 넣기. 비어 있으면 k3s 제외)
MCP_ENABLED=true
K3S_MCP_TOKEN=
MCP_CHAT_ENABLED=true               # 자기방 "@AI 운영 …" / 키워드 질의
MCP_AGENT_ENABLED=true              # 이슈 에이전트에 읽기 전용 MCP 도구 제공

# 로컬 프리뷰(화면 검증): scripts/setup-preview.ps1 실행 후 사용. 로그인 계정은 받으면 채운다.
PREVIEW_ENABLED=false
PREVIEW_LOGIN_ID=
PREVIEW_LOGIN_PW=

GITLAB_ENABLED=false
GITLAB_URL=https://gitlab.example.co.kr
GITLAB_TOKEN=                       # PAT scope: api, write_repository (코멘트/MR/푸시)
GITLAB_PROJECTS=group/repo-a,group/repo-b   # 초기값. 관리 페이지/명령으로 바꾸면 DB 값이 우선
GITLAB_PREFETCH=true
GITLAB_CONCURRENCY=2                 # 동시 처리 이슈 수(프리뷰 Tomcat 은 1개 공유)
GITLAB_AGENT_TIMEOUT_MS=3600000      # 분석(설계) 1회 실행 상한 60분
GITLAB_AGENT_FIX_TIMEOUT_MS=14400000 # 개발(수정·재수정) 1회 실행 상한 4시간 — 큰 이슈용. 상한에 걸리면 변경을 보존한 채 리뷰 대기(「피드백: 이어서 진행」으로 재개)
GITLAB_AGENT_FIX_MAX_TURNS=600       # 개발 턴 상한(분석은 GITLAB_AGENT_MAX_TURNS=80)
GITLAB_AGENT_IDLE_TIMEOUT_MS=2700000 # 무응답 상한 45분(긴 gradlew build 동안은 출력이 없다 — 11-13 20분에 끊긴 실측)(출력이 전혀 없으면 멈춘 것으로 보고 중단, 0=끔)
GITLAB_VERIFY_REVIEWER_TIMEOUT_MS=3600000 # 검증 리뷰어 세션 상한 60분
USAGE_WINDOW_BUDGET=2000000          # 상단바 사용량 배터리의 5시간 토큰 예산(추정). 실제 한도에 걸리면 그 시점 사용량으로 자동 학습
USAGE_PLAN_API=true                  # 상단바 배터리에 구독 사용률(실제값, Claude Code OAuth 토큰 재사용) 표시. false 면 토큰 집계 추정치만
GITLAB_LABEL=ai-fix
# 검증 단계(수정 후 봇 검사 + 독립 리뷰어, 실패 시 자동 재수정). 프로젝트별 검사 명령 예: GITLAB_VERIFY_COMMANDS=grp/repo-a=mvn -o -q compile;grp/repo-b=gradlew.bat test
GITLAB_VERIFY_ENABLED=true
GITLAB_VERIFY_MAX_RETRIES=2
GITLAB_VERIFY_REVIEWER=true
GITLAB_VERIFY_MODEL=
GITLAB_VERIFY_EFFORT=medium
GITLAB_VERIFY_COMMANDS=
GITLAB_SCAN_INTERVAL_MS=120000
GITLAB_WORK_DIR=work                # 저장소 clone 위치(.gitignore 됨)
# 브랜치/커밋 컨벤션(Document: ko/convention/convention/branch_convention). 브랜치 {유형}/{일감번호}, 일반은 develop 기준→develop MR, hotfix 는 main 기준
GITLAB_BASE_BRANCH=develop
GITLAB_HOTFIX_BASE=main
GITLAB_MR_TARGET=develop
GITLAB_BRANCH_PREFIXES=feature,fix,refactor,doc,hotfix
GITLAB_HOTFIX_LABELS=hotfix,긴급,urgent
# 커밋 작성자(예: dev-agent). GitLab 에 같은 이메일의 계정이 있으면 그 프로필로 연결된다
GITLAB_GIT_USER_NAME=dev-agent
GITLAB_GIT_USER_EMAIL=dev-agent@example.com
GITLAB_COMMENT_ON_ISSUE=true
GITLAB_CREATE_MR=true
# 코딩용 Claude(저장소에서 claude -p, 채팅 warm 세션과 별개). 분석은 읽기 전용, 수정은 편집+지정 명령만.
GITLAB_AGENT_MODEL=opus
GITLAB_AGENT_EFFORT=high
GITLAB_AGENT_MAX_TURNS=80
# 허용 명령은 application.yml 의 gitlab.agent.fix-tools 기본값 참고. 프로젝트에 맞게 덮어쓰려면:
# GITLAB_AGENT_FIX_TOOLS=Read,Grep,Glob,LS,Edit,Write,MultiEdit,Bash(git diff:*),Bash(gradlew:*),Bash(npm test:*)
# GITLAB_AGENT_TEST_HINT=gradlew test 실행

# ── DB (Postgres) ────────────────────────────────────────
# DB_URL 을 비우면(또는 세 줄을 지우면) 내장 PostgreSQL 을 씁니다 — Docker 불필요, 데이터는 홈의 pgdata-embedded/.
# 내장 DB 포트를 바꾸려면 DB_EMBEDDED_PORT(기본 54329).
DB_URL=jdbc:postgresql://localhost:5432/dev_agent
DB_USERNAME=dev_agent
DB_PASSWORD=change_me

# ── 관리 페이지 ──────────────────────────────────────────
ADMIN_PORT=8777
# 루프백 외에 상태 변경 요청을 허용할 Origin(쉼표 구분, 정확히 일치). tailscale serve 뒤에서 쓸 때 https://<MagicDNS 이름>:8443
# ACCESS_ALLOWED_ORIGINS=

# --- 질의(리서치) 워크플로우 (대시보드 "질의" 탭 / @AI 질문 batch: …) ---
RESEARCH_ENABLED=true
RESEARCH_TIMEOUT_MS=1800000           # 질문 1건 상한(30분)
RESEARCH_MAX_TURNS=60
RESEARCH_MODEL=                       # 비우면 '기획' 모델. 질의마다 화면에서 선택 가능
RESEARCH_EFFORT=
# RESEARCH_ATTACHMENT_KEEP_DAYS=7     # 질문에 붙인 이미지: 스레드가 끝나고 이 일수가 지나면 파일 삭제(0 = 지우지 않음)
RESEARCH_VERIFY=true                  # 질의 결과 2차 검증(독립 검증자가 소스와 대조, 지적 시 1회 수정). 질의마다 화면에서 끌 수 있음

# --- 플랫폼 관리(상단바 렌치 버튼 → 채팅 창: 플랫폼 자체의 버그 확인·수정·빌드·커밋·스킬 등록) ---
# 실행 디렉터리가 소스 저장소면(이 호스트의 run.cmd 방식) 설정 없이 켜진다. 배포판(실행 파일)은 소스를 받아 둔 경로를 지정해야 켜진다.
# MAINTAIN_ENABLED=true
# MAINTAIN_REPO_DIR=                  # 플랫폼 소스 저장소 경로(.git · build.gradle · src/main/java)
# MAINTAIN_MODEL=                     # 비우면 '개발' 모델. 대화마다 창에서 선택 가능
# MAINTAIN_TIMEOUT_MS=7200000         # 요청 1건 상한(2시간)
# MAINTAIN_MAX_TURNS=300

# --- 플랫폼 어댑터 선택(포트-어댑터). 기본값이면 생략 가능 ---
# (메신저는 맨 위 PLATFORM_MESSENGER 에서 지정)
PLATFORM_CHAT_MODEL=claude-cli        # ChatModel/ToolChatModel 구현체 (요약·멘션·@AI·운영 질의)
PLATFORM_CODING_AGENT=claude-cli      # CodingAgent 구현체 (이슈 분석/수정/검증, 질의)
PLATFORM_KNOWLEDGE=mkdocs-keyword     # KnowledgeSource 구현체 (사내 문서 검색. 벡터 RAG 어댑터를 추가하면 여기서 전환)

# --- 로그 ---
LOG_LEVEL_APP=INFO                    # DEBUG 로 올리면 SQL·파라미터까지 찍힌다(로그가 10배쯤 늘고 메시지 본문이 남는다). 추적할 때만

# --- 에이전트 작업 디렉터리 ---
# 저장소 clone·worktree·MCP 설정·스킬 파일이 놓이는 곳. 이 저장소 밖 경로로 지정할 것:
# 안(기본값 work)에 두면 Claude Code 가 상위의 이 저장소 CLAUDE.md 를 대상 저장소 세션에도 읽어 토큰이 들고 규칙이 섞인다.
GITLAB_WORK_DIR=

# --- Claude Code CLI 위치 ---
# 비우면 자동 탐색(PATH → npm 전역 → ~/.local/bin → Homebrew). 특이한 위치에 설치했을 때만 실행 파일 절대 경로를 적는다.
# CLAUDE_EXE_COMMAND=

# --- 실행 파일 모드(Dev Agent.exe / dev-agent.sh) — OS 환경변수로만 지정 ---
# DEV_AGENT_HOME       홈 폴더(기본 ~/.dev-agent): .env · logs · 내장 DB · 작업 디렉터리
# DEV_AGENT_JAVA_OPTS  앱 JVM 옵션(기본 -XX:+UseSerialGC -Xms32m -Xmx512m -XX:TieredStopAtLevel=1)
