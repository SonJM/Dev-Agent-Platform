# 서버용 .env 예시 — 키 이름과 설명만 있다. 값은 서버에서 채운다. 저장소에 값을 적지 않는다.
# 서버의 <앱 홈>/.env 로 복사해 권한 600, 줄바꿈 LF 로 저장한다(deploy/README.md §4). CRLF 로 저장하면 값 끝에 CR 이 붙을 수 있다.
# 숫자형·기본값이 있는 키는 빈 값(KEY=)으로 두지 않는다 — 기본값을 빈 문자열로 덮는다. 쓰지 않으면 주석으로 둔다.

# --- 접근 제어 (T-002) ---
# tailscale serve 로 여는 주소를 정확히 적는다(쉼표 구분, 경로 없음). 형태: https://<MagicDNS 이름>:8443
# 비우면 루프백 외 Origin 의 상태 변경 요청이 403 이다. 값이 맞는지는 절차서 §8 에서 확인한다.
ACCESS_ALLOWED_ORIGINS=<https://MagicDNS 이름:8443>
# 화면 포트(기본 8777, 바인딩은 127.0.0.1 고정). 바꿀 때만 주석을 푼다
# ADMIN_PORT=8777

# --- 공유 PostgreSQL 의 전용 DB ---
# DB_URL 은 여기에 적지 않는다. 서버에서는 unit 의 ExecStartPre(resolve-db.sh)가 기동 때 컨테이너 주소를
# 조회해 DB_URL 을 만든다. 여기에 DB_URL 줄이 있으면 시작이 거부된다(주석 처리한 줄은 무방).
DB_USERNAME=<전용 role 이름>
DB_PASSWORD=<전용 role 비밀번호>

# --- 에이전트 작업 디렉터리 (앱 홈 밖 경로 — 홈 안에 두면 에이전트 세션이 상위 CLAUDE.md 를 읽는다) ---
ISSUE_WORK_DIR=<앱 홈 밖의 절대 경로>

# --- GitHub (이슈 에이전트 · 질의에 필요) ---
ISSUE_ENABLED=true
# fine-grained PAT: Repository access "All repositories"(개인 계정 저장소 전부, 조직 저장소 제외), 권한 Contents·Issues·Pull requests 읽기/쓰기 + Metadata 읽기,
# 만료 90일 안팎(만료 14일 전부터 설치 점검이 경고). 토큰이 새면 개인 저장소 전부가 노출된다. 서버 .env(권한 600)에만 두고, 앱은 대상 프로젝트로 고른 저장소만 처리한다.
# 대상 프로젝트는 플랫폼 탭 「GitHub에서 고르기」·직접 입력·메신저 명령으로 바꾼다.
GITHUB_TOKEN=<토큰>
#GITHUB_TRUSTED_AUTHORS_ONLY=true   # 기본 켜짐: 이슈 작성자가 저장소 OWNER/MEMBER/COLLABORATOR 일 때만 처리
ISSUE_PROJECTS=<owner/repo,owner/repo>
# ISSUE_GIT_USER_NAME=
# ISSUE_GIT_USER_EMAIL=

# --- Claude Code CLI — 비우면 자동으로 찾는다. 못 찾으면(npm 전역·nvm 경로 등) 절대 경로를 적는다 ---
# CLAUDE_EXE_COMMAND=

# --- 서버에서 끄는 기능 ---
# 플랫폼 관리(코드 수정 세션). 서버 사용 여부 미정(OI-14)이라 기본 끔
MAINTAIN_ENABLED=false
